# =========================================================================
# 사용법:  cp .env.example .env   후 아래 [필수] 3칸만 채우면 됩니다.
# 나머지는 기본값 그대로 두면 집 GPU PC 실구동 기준으로 동작합니다.
# =========================================================================
# ⚠️ .env 는 .gitignore 로 커밋되지 않습니다. private 레포라도 실제 키는
#    커밋/업로드하지 마세요(유출 위험). 키는 각 PC의 .env 에만 둡니다.
# =========================================================================


# ========================= [필수] 여기만 채우기 ==========================

# pyannote 화자분리용 HF 토큰. huggingface.co/settings/tokens (read) + 게이트 3종 동의
HF_TOKEN=

# Vexa API 키 — 셀프호스팅이 로컬에서 자동 생성(`make all` 출력 `vxa_...`). 외부 발급 아님.
VEXA_API_KEY=

# (선택) internal 프로파일을 Gemini(클라우드)로 쓸 때만. 비워두면 로컬 Ollama로 폴백
GEMINI_API_KEY=


# ===================== [기본값] 그대로 두세요 ============================

# --- LLM (로컬 Ollama) ---  ※ 먼저: ollama pull qwen2.5:14b
OLLAMA_HOST=http://localhost:11434
# GPU 없이 CPU로 돌린다면 14b는 너무 느립니다 — 7b(또는 3b)를 쓰세요.
OLLAMA_MODEL=qwen2.5:14b
# 로컬 LLM 응답 대기 한도(초). CPU면 넉넉히.
OLLAMA_TIMEOUT=1800
# 컨텍스트 상한. 프롬프트가 이걸 넘으면 Ollama 가 앞부분을 조용히 버립니다(요약 품질 붕괴).
# 필요한 만큼 요청마다 자동으로 잡되, 그 상한을 여기서 정합니다. CPU면 크게 잡을수록 느려집니다.
OLLAMA_MAX_CTX=16384
# 회의를 몇 글자씩 잘라 LLM에 넘길지. CPU 로컬 LLM 기준 3000.
# GPU·클라우드 LLM이면 6000 이상도 좋습니다(문맥이 넓어져 요약 품질이 오름).
MINUTES_CHUNK_CHARS=3000
# 출력(생성) 토큰 상한. 없으면 소형 모델이 같은 말을 반복하며 안 멈춥니다.
# 잘렸다는 경고가 뜨면 늘리고, 폭주하면 줄이세요.
OLLAMA_NUM_PREDICT=2048
# 단계별 출력 상한(토큰). 구간 요약이 길면 요약이 아니고, CPU에서는 출력 길이가 곧 시간입니다
# (3.9 tok/s면 2000토큰 = 8분, 600토큰 = 2.5분).
LLM_MAX_TOKENS_SUMMARY=600
LLM_MAX_TOKENS_INTEGRATE=2048
# 토큰이 이 시간(초) 동안 안 오면 죽은 것으로 보고 끊습니다(전체 타임아웃과 별개).
OLLAMA_STALL_TIMEOUT=180
# CPU 스레드. 0이면 Ollama 기본. 느리면 python scripts/bench_llm.py --threads 0,4,8,12
# 로 비교해 가장 빠른 값을 넣으세요.
OLLAMA_NUM_THREAD=0
# 용어 교정 단계(1단계)는 전사 전문을 LLM이 그대로 다시 출력해서 가장 비쌉니다.
# CPU에서 시간을 반으로 줄이려면 0 으로 끄세요(회의록 품질에는 영향 적음).
LLM_TERM_CORRECTION=1

# --- 전사 / 화자분리 (로컬 GPU) ---
ASR_ENGINE=faster-whisper
# 첫 실행 때 모델을 받습니다(large-v3 ≈ 3GB, 1회).
# ※ 무엇을 쓸지 모르겠으면: python scripts/check_env.py  → 이 PC에 맞는 값을 알려줍니다.
#   GPU 있음  → large-v3
#   CPU 전용  → deepdml/faster-whisper-large-v3-turbo-ct2 (large급 품질 · 훨씬 빠름)
#               또는 medium(≈1.5GB). large-v3는 CPU에서 실시간보다 느립니다.
WHISPER_MODEL=large-v3
# 전사 디바이스: auto(GPU 있으면 CUDA) | cuda | cpu.
# GPU가 말썽이면 cpu 로 되돌리세요.
WHISPER_DEVICE=auto
DIARIZER=auto

# --- 전사 속도 튜닝 (0 = 자동) ---
# 빔 크기: 비우면 CPU는 1(greedy·빠름), GPU는 5. CPU에서 5는 1.5~2배 느립니다.
WHISPER_BEAM_SIZE=0
# 배치 추론(faster-whisper 1.1+): 8 정도면 체감이 큽니다. 0 이면 끔.
WHISPER_BATCH_SIZE=0
# CPU 스레드: 0 이면 자동. 물리 코어 수를 넣으면 대개 가장 빠릅니다.
WHISPER_CPU_THREADS=0
# 연산 정밀도: auto 면 CPU에서 int8을 고릅니다. 품질이 의심되면 int8_float32.
WHISPER_COMPUTE_TYPE=auto

# --- Vexa 봇 ---  ※ 셀프호스팅 API 게이트웨이 기본 포트 = 18056
VEXA_API_URL=http://localhost:18056
VEXA_BOT_NAME=회의록봇

# --- HTTP 서비스 / n8n ---
MINUTES_SERVER_HOST=127.0.0.1
MINUTES_SERVER_PORT=8900
MINUTES_SERVER_URL=http://127.0.0.1:8900

# --- 업로드 상한 (대시보드) ---
# 녹음본은 디스크로 스트리밍 저장하므로 커도 메모리를 쓰지 않는다(1시간 m4a ≈ 30MB).
MINUTES_MAX_UPLOAD_MB=500
# 전사 JSON·회의록 MD 는 요청 본문을 통째로 메모리에 올리는 경로라 보수적으로 둔다.
MINUTES_MAX_TEXT_UPLOAD_MB=5

# --- 회의록 문체 ---
# 개조식(명사형 종결·마침표 없음)이 기본. 어체는 prompts/03_integrate_minutes.md 가 만들고,
# 여기서는 마침표 제거만 켜고 끈다. 서술체로 쓰려면 프롬프트를 고치고 0 으로.
MINUTES_STRIP_PERIODS=1

# --- 기타(미사용/선택) ---
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
# ALERT_WEBHOOK_URL=          # 완료/실패 알림(Slack 등) 쓸 때만


# ============ [회사 노트북 개발용] GPU/키 없이 배관만 볼 때 ==============
#   아래 4줄 주석 해제하면 mock 으로 전 구간 동작(네트워크·GPU·모델 불필요)
# LLM_PROVIDER=mock
# VEXA_CLIENT=mock
# ASR_ENGINE=mock
# DIARIZER=mock
