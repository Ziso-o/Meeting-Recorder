# .env.example — 키 목록만. 실제 값은 .env에 넣고 커밋하지 말 것.
# 사용법: cp .env.example .env  후 값 채우기

# --- LLM 프로바이더 ---
# 보안 프로파일이 secure면 Ollama(로컬), internal이면 Gemini(클라우드)를 사용
LLM_PROVIDER=ollama            # ollama | gemini

# Ollama (로컬, 민감 회의)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Gemini (클라우드, 내부 회의) — Phase 1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- 전사 (Phase 2) ---
# Hugging Face 토큰 (pyannote 화자분리)
HF_TOKEN=

# Groq (GPU 없을 때 전사 fallback)
GROQ_API_KEY=

# --- Vexa 봇 (Phase 4) ---
VEXA_API_URL=
VEXA_API_KEY=
VEXA_BOT_NAME=회의록봇
