# .env.example — 키 목록만. 실제 값은 .env에 넣고 커밋하지 말 것.
# 사용법: cp .env.example .env  후 값 채우기
#
# ┌─ 머신별 프리셋 (회사 노트북 / 집 GPU PC 병행 개발) ─────────────────┐
# │ ▶ 회사 저사양 노트북 = "개발/플러밍": 무거운 LLM·Vexa 실행 X.        │
# │     → LLM_PROVIDER=mock, VEXA_CLIENT=mock, ASR_ENGINE=mock 로 배관만 │
# │ ▶ 집 GPU PC(지포스 50번대) = "실구동": 아래 [GPU 프리셋] 주석 해제.   │
# │     large-v3 + qwen2.5:14b + 실제 Vexa/HF 토큰.                       │
# └──────────────────────────────────────────────────────────────────────┘

# =========================================================================
# LLM 프로바이더 (회의록 작성)
# =========================================================================
# 회사 노트북(개발): 무거우니 mock 권장 ↓ (주석 해제)
# LLM_PROVIDER=mock
# 미설정 시: secure→Ollama, internal→(GEMINI 키 있으면 Gemini, 없으면 Ollama)

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b          # 저사양=7b / 집 GPU PC=아래 GPU 프리셋에서 14b로

# Gemini(클라우드) — internal용, 키 있을 때만. B2G 민감회의엔 사용 금지.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =========================================================================
# 전사 (STT / 화자분리)
# =========================================================================
ASR_ENGINE=auto                  # auto=로컬 faster-whisper / 회사노트북 개발=mock
WHISPER_MODEL=medium             # CPU=medium·small / 집 GPU PC=large-v3
DIARIZER=auto                    # auto: HF_TOKEN 있으면 pyannote, 없으면 단일화자
HF_TOKEN=                        # pyannote 화자분리(무료, 게이트 동의 필요)
GROQ_API_KEY=                    # 클라우드 전사 폴백(정책상 미사용)

# =========================================================================
# ▼▼▼ [GPU 프리셋] 집 GPU PC(지포스 50번대)에서만 주석 해제 ▼▼▼
#   - GPU 보류 중이면 그대로 주석 유지. 실구동 시 아래로 덮어씀.
# =========================================================================
# ASR_ENGINE=faster-whisper
# WHISPER_MODEL=large-v3         # GPU면 최고 품질
# DIARIZER=pyannote
# OLLAMA_MODEL=qwen2.5:14b       # 먼저: ollama pull qwen2.5:14b  (여유되면 32b)
# ▲▲▲ [GPU 프리셋] 끝 ▲▲▲

# =========================================================================
# Vexa 봇 (실시간 회의 참가 + STT)
# =========================================================================
# 회사 노트북(개발): 실제 Vexa 없이 배관만 → 주석 해제
# VEXA_CLIENT=mock
#
# 집 GPU PC(실구동): Vexa 셀프호스팅 후 실제 값. 포트/URL은 배포본에서 확인!
VEXA_API_URL=http://localhost:8000    # 셀프호스팅 게이트웨이 주소(버전별 포트 확인 필요)
VEXA_API_KEY=                          # Vexa에서 발급받은 API 키
VEXA_BOT_NAME=회의록봇                  # 회의 참석자 목록에 보이는 봇 이름
# VEXA_IMAGE=...                        # (참고) docker-compose vexa 서비스 이미지
# VEXA_ADMIN_KEY=                       # Vexa 관리자 키(사용자/토큰 발급용)
