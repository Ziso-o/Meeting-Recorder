# .env.example — 키 목록만. 실제 값은 .env에 넣고 커밋하지 말 것.
# 사용법: cp .env.example .env  후 값 채우기
#
# ┌─ 무료·로컬 MVP 프리셋 (권장 기본) ─────────────────────────────┐
# │ 아래 기본값만으로 클라우드 없이 완전 로컬 구동이 가능하다.       │
# │  - LLM     : Ollama (로컬)                                      │
# │  - 전사    : faster-whisper (로컬, GPU 없으면 CPU)              │
# │  - 화자분리: HF_TOKEN 있으면 pyannote, 없으면 자동 비활성       │
# │ Groq/Gemini(클라우드)는 키를 넣었을 때만 선택적으로 켜진다.     │
# └────────────────────────────────────────────────────────────────┘

# --- LLM 프로바이더 ---
# 미설정 시: secure→Ollama, internal→(GEMINI_API_KEY 있으면 Gemini, 없으면 Ollama 폴백)
# 특정 프로바이더로 강제하려면 주석 해제.
# LLM_PROVIDER=ollama          # ollama | gemini | mock

# Ollama (로컬) — 무료. 먼저 `ollama pull` 필요.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b        # CPU/저사양=7b 권장, GPU/고사양=qwen2.5:14b

# Gemini (클라우드, internal) — 키가 있을 때만 사용. 무료티어 확인 후.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- 전사 (Phase 2) ---
# 전사 엔진: auto(기본)=로컬 faster-whisper. groq는 명시했을 때만(클라우드).
ASR_ENGINE=auto               # auto | faster-whisper | groq | mock
WHISPER_MODEL=medium          # CPU=medium/small 권장, GPU=large-v3
# 화자분리: auto(기본). HF_TOKEN 없으면 자동 비활성(단일 화자). 강제하려면 pyannote / 끄려면 off
DIARIZER=auto                 # auto | pyannote | off | mock
# Hugging Face 토큰 (pyannote 화자분리) — 무료(게이트 모델 동의 필요)
HF_TOKEN=

# Groq (클라우드 전사) — 키가 있고 ASR_ENGINE=groq 일 때만. 무료티어 확인 후.
GROQ_API_KEY=

# --- Vexa 봇 (Phase 4) ---
VEXA_API_URL=http://vexa:8000       # docker 내부. 로컬 직접호출은 http://localhost:8000
VEXA_API_KEY=
VEXA_BOT_NAME=회의록봇                # 봇 표시명 (회의 참석자 목록에 보이는 이름)
# VEXA_CLIENT=mock                  # 오프라인/테스트 시 mock 클라이언트 사용
# VEXA_IMAGE=vexaai/vexa-gateway:latest   # docker-compose vexa 서비스 이미지(교체 필요)
# VEXA_ADMIN_KEY=                   # Vexa 관리자 키(운영 스택)
