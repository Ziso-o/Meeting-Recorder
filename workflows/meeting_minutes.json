{
  "name": "회의록 자동화 (Meeting Minutes)",
  "nodes": [
    {
      "parameters": {
        "path": "/data/inbox",
        "events": ["add"],
        "options": {}
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "폴더 감시 (inbox)",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-audio",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "웹훅 (수동 트리거)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 500],
      "webhookId": "a2222222-2222-4222-8222-222222222222"
    },
    {
      "parameters": {
        "jsCode": "// 트리거(폴더/웹훅)에서 오디오 경로를 얻고 보안 프로파일을 결정한다.\nconst item = $input.first().json;\nconst path = item.path || (item.body && item.body.audioPath) || item.audioPath;\nif (!path) { throw new Error('오디오 경로를 찾을 수 없습니다 (path / body.audioPath)'); }\n\n// 보안등급 분기: 경로/파일명에 'secure'가 있으면 민감 회의(로컬 LLM).\nconst lower = String(path).toLowerCase();\nconst profile = lower.includes('secure') ? 'secure' : 'internal';\n\n// 확장자 제거한 stem (산출물 경로 베이스)\nconst stem = String(path).replace(/\\.[^/.]+$/, '');\n\nreturn [{ json: { audioPath: path, profile, stem } }];"
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "command": "={{ 'cd ' + $env.MINUTES_HOME + ' && ASR_ENGINE=' + ($env.ASR_ENGINE || 'groq') + ' DIARIZER=' + ($env.DIARIZER || 'pyannote') + ' ' + $env.MINUTES_PY + ' -m minutes.transcribe --audio \"' + $('Config').item.json.audioPath + '\" --glossary ' + $env.MINUTES_HOME + '/glossary.yaml --out \"' + $('Config').item.json.stem + '\"' }}"
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "전사 (transcribe)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [700, 400],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "command": "={{ 'cd ' + $env.MINUTES_HOME + ' && ' + $env.MINUTES_PY + ' -m minutes.generate --input \"' + $('Config').item.json.stem + '.transcript.json\" --profile ' + $('Config').item.json.profile + ' --glossary ' + $env.MINUTES_HOME + '/glossary.yaml --out \"' + $('Config').item.json.stem + '\"' }}"
      },
      "id": "a5555555-5555-4555-8555-555555555555",
      "name": "회의록 생성 (generate)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [940, 400],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-secure",
              "leftValue": "={{ $('Config').item.json.profile }}",
              "rightValue": "secure",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a6666666-6666-4666-8666-666666666666",
      "name": "보안등급 분기",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1180, 400]
    },
    {
      "parameters": {
        "command": "={{ 'mkdir -p /data/out/secure && cp \"' + $('Config').item.json.stem + '.minutes.md\" \"' + $('Config').item.json.stem + '.minutes.json\" /data/out/secure/' }}"
      },
      "id": "a7777777-7777-4777-8777-777777777777",
      "name": "배포: 보안(secure)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1420, 280],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "command": "={{ 'mkdir -p /data/out/internal && cp \"' + $('Config').item.json.stem + '.minutes.md\" \"' + $('Config').item.json.stem + '.minutes.json\" /data/out/internal/' }}"
      },
      "id": "a8888888-8888-4888-8888-888888888888",
      "name": "배포: 내부(internal)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1420, 500],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL || 'http://localhost:9999/noop' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '✅ 회의록 생성 완료 (internal): ' + $('Config').item.json.stem + '.minutes.md' }) }}",
        "options": {}
      },
      "id": "a9999999-9999-4999-8999-999999999999",
      "name": "알림: 완료",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1660, 500],
      "continueOnFail": true
    },
    {
      "parameters": {},
      "id": "b1111111-1111-4111-8111-111111111111",
      "name": "에러 트리거",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [700, 720]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL || 'http://localhost:9999/noop' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '🚨 회의록 워크플로우 실패: ' + ($json.workflow ? $json.workflow.name : '') + ' / node: ' + ($json.execution && $json.execution.lastNodeExecuted ? $json.execution.lastNodeExecuted : 'unknown') + ' / error: ' + ($json.execution && $json.execution.error ? $json.execution.error.message : '') }) }}",
        "options": {}
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "알림: 실패",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 720],
      "continueOnFail": true
    }
  ],
  "connections": {
    "폴더 감시 (inbox)": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "웹훅 (수동 트리거)": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "전사 (transcribe)", "type": "main", "index": 0 }]]
    },
    "전사 (transcribe)": {
      "main": [[{ "node": "회의록 생성 (generate)", "type": "main", "index": 0 }]]
    },
    "회의록 생성 (generate)": {
      "main": [[{ "node": "보안등급 분기", "type": "main", "index": 0 }]]
    },
    "보안등급 분기": {
      "main": [
        [{ "node": "배포: 보안(secure)", "type": "main", "index": 0 }],
        [{ "node": "배포: 내부(internal)", "type": "main", "index": 0 }]
      ]
    },
    "배포: 내부(internal)": {
      "main": [[{ "node": "알림: 완료", "type": "main", "index": 0 }]]
    },
    "에러 트리거": {
      "main": [[{ "node": "알림: 실패", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "description": "폴더감시/웹훅 → 전사 → 회의록 생성 → 보안등급 분기 → Markdown 배포 → 실패 시 재시도·알림"
  }
}
