{
  "name": "Vexa 회의 봇 연동 (Phase 4)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bot-dispatch",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c1111111-1111-4111-8111-111111111111",
      "name": "웹훅: 봇 참석 요청",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 260],
      "webhookId": "c1111111-1111-4111-8111-111111111111"
    },
    {
      "parameters": {
        "command": "={{ 'cd ' + $env.MINUTES_HOME + ' && ' + $env.MINUTES_PY + ' -m minutes.bot request --platform ' + ($json.body.platform || 'google_meet') + ' --meeting ' + $json.body.meetingId }}"
      },
      "id": "c2222222-2222-4222-8222-222222222222",
      "name": "봇 dispatch",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 260],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-end",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "웹훅: 회의 종료",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 480],
      "webhookId": "c3333333-3333-4333-8333-333333333333"
    },
    {
      "parameters": {
        "jsCode": "// 회의 종료 웹훅 body에서 회의 정보와 보안 프로파일을 파싱한다.\nconst b = $input.first().json.body || {};\nconst meetingId = b.meetingId || b.native_meeting_id;\nif (!meetingId) { throw new Error('meetingId가 없습니다'); }\nconst platform = b.platform || 'google_meet';\n// 보안등급: body.profile 우선, 없으면 b.secure(bool) → secure/internal\nconst profile = b.profile || (b.secure ? 'secure' : 'internal');\nconst stem = '/data/work/vexa_' + String(meetingId).replace(/[^a-zA-Z0-9_-]/g, '_');\nreturn [{ json: { platform, meetingId, profile, stem, title: b.title || '', date: b.date || '' } }];"
      },
      "id": "c4444444-4444-4444-8444-444444444444",
      "name": "Config Vexa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 480]
    },
    {
      "parameters": {
        "command": "={{ 'cd ' + $env.MINUTES_HOME + ' && mkdir -p /data/work && ' + $env.MINUTES_PY + ' -m minutes.bot ingest --platform ' + $('Config Vexa').item.json.platform + ' --meeting ' + $('Config Vexa').item.json.meetingId + ' --profile ' + $('Config Vexa').item.json.profile + ' --glossary ' + $env.MINUTES_HOME + '/glossary.yaml --out \"' + $('Config Vexa').item.json.stem + '\"' }}"
      },
      "id": "c5555555-5555-4555-8555-555555555555",
      "name": "인제스트 (Vexa전사→회의록)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [700, 480],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-secure",
              "leftValue": "={{ $('Config Vexa').item.json.profile }}",
              "rightValue": "secure",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c6666666-6666-4666-8666-666666666666",
      "name": "보안등급 분기",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 480]
    },
    {
      "parameters": {
        "command": "={{ 'mkdir -p /data/out/secure && cp \"' + $('Config Vexa').item.json.stem + '.minutes.md\" \"' + $('Config Vexa').item.json.stem + '.minutes.json\" /data/out/secure/' }}"
      },
      "id": "c7777777-7777-4777-8777-777777777777",
      "name": "배포: 보안(secure)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1180, 380],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "command": "={{ 'mkdir -p /data/out/internal && cp \"' + $('Config Vexa').item.json.stem + '.minutes.md\" \"' + $('Config Vexa').item.json.stem + '.minutes.json\" /data/out/internal/' }}"
      },
      "id": "c8888888-8888-4888-8888-888888888888",
      "name": "배포: 내부(internal)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1180, 580],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL || 'http://localhost:9999/noop' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '✅ Vexa 회의록 생성 완료: ' + $('Config Vexa').item.json.meetingId }) }}",
        "options": {}
      },
      "id": "c9999999-9999-4999-8999-999999999999",
      "name": "알림: 완료",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 580],
      "continueOnFail": true
    },
    {
      "parameters": {},
      "id": "d1111111-1111-4111-8111-111111111111",
      "name": "에러 트리거",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [700, 760]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL || 'http://localhost:9999/noop' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '🚨 Vexa 워크플로우 실패: ' + ($json.execution && $json.execution.lastNodeExecuted ? $json.execution.lastNodeExecuted : 'unknown') }) }}",
        "options": {}
      },
      "id": "d2222222-2222-4222-8222-222222222222",
      "name": "알림: 실패",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 760],
      "continueOnFail": true
    }
  ],
  "connections": {
    "웹훅: 봇 참석 요청": {
      "main": [[{ "node": "봇 dispatch", "type": "main", "index": 0 }]]
    },
    "웹훅: 회의 종료": {
      "main": [[{ "node": "Config Vexa", "type": "main", "index": 0 }]]
    },
    "Config Vexa": {
      "main": [[{ "node": "인제스트 (Vexa전사→회의록)", "type": "main", "index": 0 }]]
    },
    "인제스트 (Vexa전사→회의록)": {
      "main": [[{ "node": "보안등급 분기", "type": "main", "index": 0 }]]
    },
    "보안등급 분기": {
      "main": [
        [{ "node": "배포: 보안(secure)", "type": "main", "index": 0 }],
        [{ "node": "배포: 내부(internal)", "type": "main", "index": 0 }]
      ]
    },
    "배포: 내부(internal)": {
      "main": [[{ "node": "알림: 완료", "type": "main", "index": 0 }]]
    },
    "에러 트리거": {
      "main": [[{ "node": "알림: 실패", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": {
    "description": "봇 참석 요청(dispatch) + 회의 종료 웹훅 → Vexa 전사 인제스트 → 보안등급 분기 → 배포/알림"
  }
}
