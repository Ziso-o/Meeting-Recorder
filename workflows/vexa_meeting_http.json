        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '🚨 Vexa 워크플로 실패: ' + ($json.execution && $json.execution.lastNodeExecuted ? $json.execution.lastNodeExecuted : 'unknown') }) }}",
