        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platform: ($json.body.platform || 'google_meet'), meeting: $json.body.meetingId }) }}",
        "options": {}
      },
      "id": "f2222222-2222-4222-8222-222222222222",
      "name": "봇 dispatch (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 260],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-end",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "f3333333-3333-4333-8333-333333333333",
      "name": "웹훅: 회의 종료",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 480],
      "webhookId": "f3333333-3333-4333-8333-333333333333"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.MINUTES_SERVER_URL || 'http://127.0.0.1:8900') + '/ingest' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platform: ($json.body.platform || 'google_meet'), meeting: $json.body.meetingId, profile: ($json.body.profile || 'secure') }) }}",
        "options": { "response": { "response": { "neverError": false } } }
      },
      "id": "f4444444-4444-4444-8444-444444444444",
