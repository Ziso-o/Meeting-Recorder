      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-end",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e3333333-3333-4333-8333-333333333333",
      "name": "웹훅: 회의 종료",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 480],
      "webhookId": "e3333333-3333-4333-8333-333333333333"
    },
    {
      "parameters": {
        "jsCode": "// 회의 정보 + 보안 프로파일 파싱. 출력 stem을 profile별 폴더로 바로 지정\n// (CLI가 --out 대상 폴더를 자동 생성하므로 셸 cp/mkdir 불필요 → OS 무관).\nconst b = $input.first().json.body || {};\nconst meetingId = b.meetingId || b.native_meeting_id;\nif (!meetingId) { throw new Error('meetingId가 없습니다'); }\nconst platform = b.platform || 'google_meet';\nconst profile = b.profile || (b.secure ? 'secure' : 'internal');\nconst home = ($env.MINUTES_HOME || '.').replace(/[\\\\/]+$/, '');\nconst safe = String(meetingId).replace(/[^a-zA-Z0-9_-]/g, '_');\nconst stem = home + '/data/out/' + profile + '/vexa_' + safe;\nreturn [{ json: { platform, meetingId, profile, stem } }];"
      },
      "id": "e4444444-4444-4444-8444-444444444444",
      "name": "Config Vexa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 480]
    },
    {
      "parameters": {
        "command": "={{ $env.MINUTES_PY + ' -m minutes.bot ingest --platform ' + $('Config Vexa').item.json.platform + ' --meeting ' + $('Config Vexa').item.json.meetingId + ' --profile ' + $('Config Vexa').item.json.profile + ' --glossary \"' + $env.MINUTES_HOME + '/glossary.yaml\" --out \"' + $('Config Vexa').item.json.stem + '\"' }}"
      },
      "id": "e5555555-5555-4555-8555-555555555555",
      "name": "인제스트 (Vexa전사→회의록)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [720, 480],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL || 'http://localhost:9999/noop' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '✅ Vexa 회의록 완료: ' + $('Config Vexa').item.json.stem + '.minutes.md' }) }}",
        "options": {}
      },
      "id": "e6666666-6666-4666-8666-666666666666",
      "name": "알림: 완료",
