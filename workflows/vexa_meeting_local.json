        "options": {}
      },
      "id": "e1111111-1111-4111-8111-111111111111",
      "name": "웹훅: 봇 참석 요청",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 260],
      "webhookId": "e1111111-1111-4111-8111-111111111111"
    },
    {
      "parameters": {
        "command": "={{ $env.MINUTES_PY + ' -m minutes.bot request --platform ' + ($json.body.platform || 'google_meet') + ' --meeting ' + $json.body.meetingId }}"
      },
      "id": "e2222222-2222-4222-8222-222222222222",
      "name": "봇 dispatch",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 260],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
